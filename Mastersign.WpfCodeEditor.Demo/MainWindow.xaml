<Window x:Class="Mastersign.WpfCodeEditor.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ye="clr-namespace:Mastersign.WpfCodeEditor;assembly=Mastersign.WpfCodeEditor"
        xmlns:local="clr-namespace:Mastersign.WpfCodeEditor.Demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBox x:Name="txtURL" 
                 Margin="10"
                 KeyDown="txtURL_KeyDown"  />
        <ye:CodeEditor x:Name="editor" Grid.Row="1" Margin="10"
                       UseDevelopmentProxy="False" />
    </Grid>
</Window>
