<ui:FluentWindow
        x:Class="MonacoEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ce="clr-namespace:Mastersign.WpfCodeEditor;assembly=Mastersign.WpfCodeEditor"
        xmlns:tools="clr-namespace:Mastersign.WpfTools"
        xmlns:local="clr-namespace:MonacoEdit"
        xmlns:p="clr-namespace:MonacoEdit.Properties"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        Title="{Binding WindowTitle, Source={x:Static local:App.Current}}"
        Height="450" Width="800"
        Loaded="WindowLoadedHandler">

    <ui:FluentWindow.Resources>
        <RoutedUICommand x:Key="Revert" Text="{x:Static p:Resources.Command_Revert}" />
        <RoutedUICommand x:Key="SelectLightTheme" Text="{x:Static p:Resources.Command_SelectLightTheme}" />
        <RoutedUICommand x:Key="SelectDarkTheme" Text="{x:Static p:Resources.Command_SelectDarkTheme}" />
        <RoutedUICommand x:Key="SelectAutoTheme" Text="{x:Static p:Resources.Command_SelectAutoTheme}" />
        <tools:BooleanToVisibilityConverter x:Key="Bool2Visibility" Invisible="Collapsed" />
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"
                        Executed="OpenCommandHandler" />
        <CommandBinding Command="{x:Static ApplicationCommands.Save}"
                        CanExecute="CanSaveCommandPredicate"
                        Executed="SaveCommandHandler" />
        <CommandBinding Command="{StaticResource Revert}"
                        CanExecute="CanRevertCommandPredicate"
                        Executed="RevertCommandHandler" />
        <CommandBinding Command="{StaticResource SelectLightTheme}"
                        Executed="SelectLightThemeCommandHandler" />
        <CommandBinding Command="{StaticResource SelectDarkTheme}"
                        Executed="SelectDarkThemeCommandHandler" />
        <CommandBinding Command="{StaticResource SelectAutoTheme}"
                        Executed="SelectAutoThemeCommandHandler" />
    </ui:FluentWindow.CommandBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ui:TitleBar 
                Grid.Row="0" Height="40"
                Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}, Mode=FindAncestor}}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Logo.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <TextBlock x:Name="txtSchemaName" Text="{Binding SecondaryTitle, Source={x:Static local:App.Current}}" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="4,0"
              Visibility="{Binding ShowToolbar, Source={x:Static local:App.Current}, Converter={StaticResource Bool2Visibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Menu x:Name="menuMain">
                <MenuItem 
                    x:Name="miOpen"
                    Icon="{ui:SymbolIcon FolderOpen16}"
                    Command="{x:Static ApplicationCommands.Open}"
                    Visibility="{Binding ShowOpen, Source={x:Static local:App.Current}, Converter={StaticResource Bool2Visibility}}"/>
                <MenuItem
                    x:Name="miRevert"
                    Icon="{ui:SymbolIcon ArrowCounterclockwise16}"
                    Command="{StaticResource Revert}"
                    Visibility="{Binding ShowRevert, Source={x:Static local:App.Current}, Converter={StaticResource Bool2Visibility}}"/>
                <MenuItem
                    x:Name="miSave"
                    Icon="{ui:SymbolIcon Save16}"
                    Command="{x:Static ApplicationCommands.Save}"
                    Visibility="{Binding ShowSave, Source={x:Static local:App.Current}, Converter={StaticResource Bool2Visibility}}"/>
            </Menu>
            <Menu x:Name="Right" Grid.Column="1">
                <MenuItem
                    x:Name="miTheme"
                    HorizontalAlignment="Right"
                    Icon="{ui:SymbolIcon DarkTheme24}">
                    <MenuItem
                    x:Name="miThemeLight"
                    Icon="{ui:SymbolIcon WeatherSunny16}"
                    Command="{StaticResource SelectLightTheme}" />
                    <MenuItem
                    x:Name="miThemeAuto"
                    Icon="{ui:SymbolIcon Wand16}"
                    Command="{StaticResource SelectAutoTheme}" />
                    <MenuItem
                    x:Name="miThemeDark"
                    Icon="{ui:SymbolIcon WeatherMoon16}"
                    Command="{StaticResource SelectDarkTheme}" />
                </MenuItem>
            </Menu>
        </Grid>

        <ce:CodeEditor
                x:Name="editor"
                Grid.Row="2" Margin="4"
                UseDevelopmentProxy="False"
                EditorReady="EditorReadyHandler">
            <ce:CodeEditor.Configuration>
                <ce:CodeEditorConfiguration
                        EnableSchemaRequests="True"
                        ShowBreadcrumbs="True"
                        ShowCodeMarkers="True"
                        CodeMarkersHeight="30vh"
                        LineNumbers="On"
                        VerticalScrollbar="Visible"
                        HorizontalScrollbar="Auto"
                        MinimapSide="Right"
                        MinimapAutohide="False"
                        MinimapShowSlider="Always"
                        />
            </ce:CodeEditor.Configuration>
        </ce:CodeEditor>
    </Grid>
</ui:FluentWindow>
